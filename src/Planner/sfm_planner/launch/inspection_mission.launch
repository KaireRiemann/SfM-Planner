<launch>
    <!-- Keep the MaRSIM scene, UAV start pose, and planner baseline aligned
         with click_cave1.launch.  cave1.yaml starts at (68.5, -29.0, 1.5). -->
    <arg name="sim_config" default="cave1.yaml"/>
    <arg name="planner_config" default="click_inspection.yaml"/>
    <arg name="planner_config_path" default=""/>
    <!-- Start this only when testing the standalone request/result mock node.
         The default LiDAR profile performs internal detection and mocks only
         capture acknowledgement inside the mission planner. -->
    <arg name="external_mock_node" default="false"/>
    <arg name="rviz" default="true"/>
    <arg name="fpv_rviz" default="true"/>
    <arg name="rviz_config" default="$(find perfect_drone_sim)/rviz/top_down.rviz"/>

    <node pkg="perfect_drone_sim" type="perfect_drone"
          name="perfect_drone" output="log" clear_params="true">
        <param name="config_name" value="$(arg sim_config)" type="string"/>
    </node>

    <node pkg="sfm_planner" name="fsm_node" type="fsm_node" output="screen" clear_params="true">
        <param if="$(eval arg('planner_config_path') != '')"
               name="config_path" value="$(arg planner_config_path)" type="string"/>
        <param unless="$(eval arg('planner_config_path') != '')"
               name="config_name" value="$(arg planner_config)" type="string"/>
    </node>

    <node if="$(arg external_mock_node)" pkg="sfm_planner" type="inspection_mock_node"
          name="inspection_mock_node" output="screen"/>

    <group if="$(arg rviz)">
        <node pkg="rviz" type="rviz" name="top_down" args="-d $(arg rviz_config)" output="log"/>
        <node if="$(arg fpv_rviz)" pkg="rviz" type="rviz" name="fpv"
              args="-d $(find perfect_drone_sim)/rviz/fpv.rviz" output="log"/>
    </group>
</launch>
